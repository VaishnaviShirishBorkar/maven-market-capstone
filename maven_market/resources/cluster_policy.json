{
  "name": "maven_market_compute_policy",
  "definition": {
    "autotermination_minutes": {
      "type": "range",
      "maxValue": 30,
      "defaultValue": 20,
      "isOptional": false
    },
    "autoscale.min_workers": {
      "type": "fixed",
      "value": 1,
      "hidden": false
    },
    "autoscale.max_workers": {
      "type": "range",
      "maxValue": 4,
      "defaultValue": 2,
      "isOptional": false
    },
    "node_type_id": {
      "type": "allowlist",
      "values": [
        "Standard_D4ds_v5",
        "Standard_D8ds_v5",
        "Standard_E4ds_v5"
      ],
      "defaultValue": "Standard_D4ds_v5"
    },
    "spark_version": {
      "type": "regex",
      "pattern": "1[56]\\.[0-9]\\.x-scala2\\.12",
      "defaultValue": "15.4.x-scala2.12"
    },
    "custom_tags.project": {
      "type": "fixed",
      "value": "maven_market"
    },
    "custom_tags.environment": {
      "type": "allowlist",
      "values": ["dev", "staging", "prod"],
      "defaultValue": "dev"
    },
    "custom_tags.cost_center": {
      "type": "fixed",
      "value": "retail_analytics_6104"
    },
    "spark_conf.spark.databricks.cluster.profile": {
      "type": "fixed",
      "value": "singleNode",
      "hidden": true
    }
  }
}
